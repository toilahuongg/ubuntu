# Sao chep file nay thanh docker.env neu can bat cac tich hop tuy chon.
# Cac gia tri local co ban (MongoDB, session, URL, dev login) da co san trong compose.yaml.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
ENABLE_TELEGRAM_NOTIFICATIONS=false

# Google OAuth (tuy chon)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (tuy chon)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
